<% if (modalOpen === "uploadForm") { %>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const popover = document.getElementById("uploadDialog");

    popover.inert = true;

    popover.showModal();

    popover.inert = false;
  });
</script>
<% } %>

<dialog id="uploadDialog" class="modal">
  <div class="dialogHeader">
    <div class="dialogTitleContainer">
      <img src="/assets/icons/upload.svg" alt="Upload icon" />
      <p class="dialogTitle">Upload an image</p>
    </div>
    <button class="closeBtn" commandfor="uploadDialog" command="close">
      <img src="/assets/icons/close.svg" alt="Close icon" />
    </button>
  </div>

  <form
    class="fileUploadForm popoverForm"
    method="POST"
    action="/post/upload"
    enctype="multipart/form-data"
  >
    <button class="uploadSelectBtn" type="button">
      <div class="uploadBtnInstruction">
        <img src="/assets/icons/add_photo.svg" alt="" draggable="false" />
        <p>Click here to select an image</p>
      </div>
    </button>
    <% if (locals.errorMessages) { %>
    <% if (errorMessages?.validationErrors?.file?.length > 0) { %>
    <p class="fieldErrorMessage">
      <%= errorMessages?.validationErrors?.file %>
    </p>
    <% } %>
    <% } %>

    <div class="inputContainer">
      <label for="file_name">
        <img src="/assets/icons/shareCode.svg" alt="" />File name</label
      >
      <div class="fileNameInputField">
        <input
          type="text"
          name="file_name"
          id="file_name"
          maxlength="50"
          disabled
        />
        <span><p class="fileNameExtension">.ext</p></span>
      </div>
      <% if (locals.errorMessages) { %>
      <% if (errorMessages?.validationErrors?.file_name?.length > 0) { %>
      <p class="fieldErrorMessage">
        <%= errorMessages?.validationErrors?.file_name %>
      </p>
      <% } %>
      <% } %>
    </div>

    <div class="folderSelectInputContainer">
      <label for="selected_folder_option">
        <img src="/assets/icons/folder.svg" alt="" draggable="false" />
        Select a folder</label
      >

      <select name="selected_folder" id="selected_folder_option">
        <% allData?.folders?.forEach((folder, index) => { %>
        <% if (values?.folderSelected) { %>
        <% if (folder.id === values?.folderSelected) { %>
        <option value="<%= folder.id %>" selected>
          <span class="directoryMark">/</span
          ><%= folder.folder_name %>
        </option>
        <% } else{%>
        <option value="<%= folder.id %>">
          <span class="directoryMark">/</span
          ><%= folder.folder_name %>
        </option>
        <% } %>
        <% } else{%>
        <% if (index === 0) { %>
        <option value="<%= folder.id %>" selected>
          <span class="directoryMark">/</span
          ><%= folder.folder_name %>
        </option>
        <% } else{%>
        <option value="<%= folder.id %>">
          <span class="directoryMark">/</span
          ><%= folder.folder_name %>
        </option>
        <% } %>
        <% } %>

        <% }) %>
      </select>
      <% if (locals.errorMessages) { %>
      <% if (errorMessages?.validationErrors?.folderSelected?.length > 0) { %>
      <p class="fieldErrorMessage">
        <%= errorMessages?.validationErrors?.folderSelected %>
      </p>
      <% } %>
      <% } %>
    </div>

    <div class="inputContainer">
      <label for="postPassword">
        <img src="/assets/icons/lock.svg" alt="" /> Secure with a password
        (Optional)</label
      >
      <div class="passwordInputField">
        <input
          type="password"
          name="postPassword"
          id="postPassword"
          class="codeInputField"
          value="<%= values?.password %>"
        />
        <button type="button" class="passwordVisibilityBtn passwordInvisible">
          <img
            src="/assets/icons/password_not_visible.svg"
            alt="show password"
          />
        </button>
      </div>
    </div>

    <div class="expiryDatefield">
      <p class="expiryDatefieldTitle">
        <img src="/assets/icons/schedule.svg" alt="" />
        Expiry date:
      </p>
      <div class="radioGroup">
        <% for( let i = 0; i < 4; i++ ) { %> <% const expiryDates = ["1", "3",
        "7", "15"] %> <%if(values?.expires_at === expiryDates[i]){%>
        <input
          type="radio"
          name="expiryDate"
          id="<%= `radio_${i+1}` %>"
          value="<%= expiryDates[i]%>"
          checked
        />
        <%} else{%>
        <%if(!values?.expires_at && i === 0){%>
        <input
          type="radio"
          name="expiryDate"
          id="<%= `radio_${i+1}` %>"
          value="<%= expiryDates[i]%>"
          checked
        />
        <%} else{%>
        <input
          type="radio"
          name="expiryDate"
          id="<%= `radio_${i+1}` %>"
          value="<%= expiryDates[i]%>"
        />
        <%}%>
        <%}%>

        <label class="radio_label" for="<%= `radio_${i+1}` %>"
          ><%if(i === 0){%>
          1 day
          <%} else{%>
          <%= `${expiryDates[i]} days`%>
          <%}%></label
        >
        <% } %>
      </div>
      <% if (locals.errorMessages) { %>
      <% if (errorMessages?.validationErrors?.expires_at?.length > 0) { %>
      <p class="fieldErrorMessage">
        <%= errorMessages?.validationErrors?.expires_at %>
      </p>
      <% } %>
      <% } %>
    </div>
    <input type="file" name="selected_image" id="imagePicker" />
    <button type="submit" class="submitBtn">Upload</button>
  </form>
</dialog>
