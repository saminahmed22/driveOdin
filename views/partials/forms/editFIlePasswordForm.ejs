<% if (modalOpen === "editPostPasswordRequired") { %>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const popover = document.getElementById("editPasswordRequiredDialog");

    popover.inert = true;

    popover.showModal();

    popover.inert = false;
  });
</script>
<% } %>

<dialog id="editPasswordRequiredDialog" class="modal">
  <div class="dialogHeader">
    <div class="dialogTitleContainer">
      <img src="/assets/icons/lock.svg" alt="Lock icon" draggable="false" />
      <p class="dialogTitle">Password required</p>
    </div>

    <button
      class="closeBtn"
      commandfor="editPasswordRequiredDialog"
      command="close"
    >
      <img src="/assets/icons/close.svg" alt="Close icon" />
    </button>
  </div>

  <form
    class="fileDownloadForm popoverForm"
    action="/post/edit/passwordRequired/<%= values?.post?.id %>"
    method="POST"
  >
    <div class="inputContainer">
      <label for="postPassword">
        <img src="/assets/icons/lock.svg" alt="" />Enter password:</label
      >
      <div class="passwordInputField">
        <input
          class="codeInputField"
          type="password"
          name="postPassword"
          id="filePasswordInput"
          maxlength="8"
        />
        <button type="button" class="passwordVisibilityBtn passwordInvisible">
          <img
            src="/assets/icons/password_not_visible.svg"
            alt="show password"
          />
        </button>
      </div>
    </div>

    <button type="submit" class="submitBtn">Submit</button>
  </form>
</dialog>
