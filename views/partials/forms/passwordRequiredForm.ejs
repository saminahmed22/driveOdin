<% if (modalOpen === "passwordRequired") { %>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const popover = document.getElementById("passwordRequiredDialog");

    popover.inert = true;

    popover.showModal();

    popover.inert = false;
  });
</script>
<% } %>

<dialog id="passwordRequiredDialog" class="modal">
  <div class="dialogHeader">
    <div class="dialogTitleContainer">
      <img src="/assets/icons/lock.svg" alt="Lock icon" draggable="false" />
      <p class="dialogTitle">Password required</p>
    </div>

    <button
      class="closeBtn"
      commandfor="passwordRequiredDialog"
      command="close"
    >
      <img src="/assets/icons/close.svg" alt="Close icon" />
    </button>
  </div>

  <p>
    This <%- values?.requestType === "post" ? "post" : "folder" %> is password
    protected.
  </p>

  <form
    class="fileDownloadForm popoverForm"
    action="/<%= values?.requestType %>/passwordRequired/<%= values?.ID %>"
    method="POST"
  >
    <div class="inputContainer">
      <label for="requiredPassword">Please enter the password:</label>
      <div class="passwordInputField">
        <input
          class="codeInputField"
          type="password"
          name="password"
          id="passwordInput"
          maxlength="8"
        />
        <button type="button" class="passwordVisibilityBtn passwordInvisible">
          <img
            src="/assets/icons/password_not_visible.svg"
            alt="show password"
          />
        </button>
      </div>
    </div>

    <button type="submit" class="submitBtn">Submit</button>
  </form>
</dialog>
