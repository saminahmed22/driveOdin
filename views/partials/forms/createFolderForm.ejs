<% if (modalOpen === "createFolder") { %>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const popover = document.getElementById("createFolderDialog");

    popover.inert = true;

    popover.showModal();

    popover.inert = false;
  });
</script>
<% } %>

<dialog id="createFolderDialog" class="modal">
  <div class="dialogHeader">
    <div class="dialogTitleContainer">
      <img src="/assets/icons/newFolder.svg" alt="New folder icon" />
      <p class="popverTitle">Create a new folder</p>
    </div>

    <button class="closeBtn" commandfor="createFolderDialog" command="close">
      <img src="/assets/icons/close.svg" alt="Close icon" />
    </button>
  </div>

  <form
    id="newFolderForm"
    class="popoverForm"
    action="/folder/new"
    method="POST"
  >
    <div class="inputContainer">
      <label for="folder_name">
        <img src="/assets/icons/folder.svg" alt="Folder icon" />Folder
        name:</label
      >
      <input
        type="text"
        name="folder_name"
        id="folder_name"
        value="<%= values?.folder_name %>"
      />

      <% if (locals.errorMessages) { %>
      <% if (errorMessages?.validationErrors?.folder_name?.length > 0) { %>
      <p class="fieldErrorMessage">
        <%= errorMessages?.validationErrors?.folder_name %>
      </p>
      <% } %>
      <% } %>
    </div>

    <div class="inputContainer">
      <label for="folderPassword">
        <img src="/assets/icons/lock.svg" alt="" />
        <span
          >Secure with a password (Optional,
          <span style="color: crimson"
            >but not setting it up will expose protected posts</span
          >)</span
        ></label
      >
      <div class="passwordInputField">
        <input
          type="password"
          name="folderPassword"
          id="folderPassword"
          class="codeInputField"
          value="<%= values?.password %>"
        />
        <button type="button" class="passwordVisibilityBtn passwordInvisible">
          <img
            src="/assets/icons/password_not_visible.svg"
            alt="show password"
          />
        </button>
      </div>
    </div>

    <button type="submit" class="submitBtn">Submit</button>
  </form>
</dialog>
