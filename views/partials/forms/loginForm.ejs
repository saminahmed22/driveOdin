<div class="container">
  <h1 class="authPageHeader">Login</h1>

  <% if (errorMessages?.passportErrors.length > 0) { %>
  <div class="passportErrorContainer">
    <p class="passportErrorMessage"><%= errorMessages?.passportErrors %></p>
  </div>
  <% } %>

  <form method="POST" action="/auth/login" class="from">
    <div class="inputContainer">
      <label for="username">Username</label>
      <input
        class="authPageInput"
        type="text"
        name="username"
        id="username"
        autocomplete="username"
        value="<%= values?.username ?? '' %>"
      />

      <% if (errorMessages?.validationErrors?.username?.length > 0) { %>
      <p class="fieldErrorMessage">
        <%= errorMessages?.validationErrors?.username %>
      </p>
      <% } %>
    </div>
    <div class="inputContainer">
      <label for="password">Password</label>
      <div class="passwordInputField">
        <input
          class="authPageInput"
          type="password"
          name="password"
          id="password"
          autocomplete="current-password"
        />
        <button type="button" class="passwordVisibilityBtn passwordInvisible">
          <img
            src="/assets/icons/password_not_visible.svg"
            alt="show password"
          />
        </button>
      </div>

      <% if (errorMessages?.validationErrors?.password?.length > 0 &&
      !errorMessages?.validationErrors?.username?.length > 0) { %>
      <p class="fieldErrorMessage">
        <%= errorMessages?.validationErrors?.password %>
      </p>
      <% } %>
    </div>
    <button class="submitBtn" type="submit">Submit</button>
  </form>
  <p class="authFromRedirect">
    Not registered yet? <a href="/auth/register">Register now!</a>
  </p>
</div>
