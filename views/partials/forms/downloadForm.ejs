<% if (modalOpen === "downloadForm") { %>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const popover = document.getElementById("downloadDialog");

    popover.inert = true;

    popover.showModal();

    popover.inert = false;
  });
</script>
<% } %>

<dialog id="downloadDialog" class="modal">
  <div class="dialogHeader">
    <div class="dialogTitleContainer">
      <img
        src="/assets/icons/download.svg"
        alt="Download icon"
        draggable="false"
      />
      <p class="dialogTitle">Receive an image or folder</p>
    </div>

    <button class="closeBtn" commandfor="downloadDialog" command="close">
      <img src="/assets/icons/close.svg" alt="Close icon" />
    </button>
  </div>

  <div class="downloadTypeOptionsContainer">
    <% if (values?.requestType === "folder") { %>
    <div class="radioGroup">
      <input
        type="radio"
        name="downloadType"
        id="download_type_radio_1"
        value="post"
      />
      <label class="radio_label" for="download_type_radio_1">Image</label>

      <input
        type="radio"
        name="downloadType"
        id="download_type_radio_2"
        value="folder"
        checked
      />
      <label class="radio_label" for="download_type_radio_2">Folder</label>
    </div>
    <% } else{ %>
    <div class="radioGroup">
      <input
        type="radio"
        name="downloadType"
        id="download_type_radio_1"
        value="post"
        checked
      />
      <label class="radio_label" for="download_type_radio_1">Image</label>

      <input
        type="radio"
        name="downloadType"
        id="download_type_radio_2"
        value="folder"
      />
      <label class="radio_label" for="download_type_radio_2">Folder</label>
    </div>
    <% } %>
  </div>

  <form class="fileDownloadForm popoverForm" action="/" method="POST">
    <div class="inputContainer">
      <label for="shareCode">
        <img src="/assets/icons/shareCode.svg" alt="" />Enter share code:</label
      >
      <input
        class="codeInputField"
        type="text"
        name="shareCode"
        id="shareCode"
        maxlength="6"
        autocomplete="off"
        value="<%= values?.shareCode %>"
      />
      <% if (locals.errorMessages) { %>
      <% if (errorMessages?.validationErrors?.shareCode?.length > 0) { %>
      <p class="fieldErrorMessage">
        <%= errorMessages?.validationErrors?.shareCode %>
      </p>
      <% } %>
      <% } %>
    </div>

    <div class="inputContainer downloadFormPasswordInputField">
      <label for="password">
        <img src="/assets/icons/lock.svg" alt="" />Enter password (If
        applicable):</label
      >
      <div class="passwordInputField">
        <input
          class="codeInputField"
          type="password"
          name="password"
          id="passwordInput"
          value="<%= values?.password %>"
        />
        <button type="button" class="passwordVisibilityBtn passwordInvisible">
          <img
            src="/assets/icons/password_not_visible.svg"
            alt="show password"
          />
        </button>
      </div>

      <% if (locals.errorMessages) { %>
      <% if (errorMessages?.validationErrors?.password?.length > 0) { %>
      <p class="fieldErrorMessage">
        <%= errorMessages?.validationErrors?.password %>
      </p>
      <% } %>
      <% } %>
    </div>

    <button type="submit" class="submitBtn">Submit</button>
  </form>
</dialog>
