<div class="container">
  <h1 class="authPageHeader">Register</h1>
  <form method="POST" action="/auth/register" class="from">
    <div class="inputContainer">
      <label for="first_name">First name</label>
      <input
        class="authPageInput"
        type="text"
        name="first_name"
        id="first_name"
        autocomplete="given-name"
        autocapitalize="words"
        value="<%= values?.firstName ?? '' %>"
      />
      <% if (errorMessages?.validationErrors?.firstName?.length > 0) { %>
      <p class="fieldErrorMessage">
        <%= errorMessages?.validationErrors?.firstName %>
      </p>
      <% } %>
    </div>
    <div class="inputContainer">
      <label for="last_name">Last Name</label>
      <input
        class="authPageInput"
        type="text"
        name="last_name"
        id="last_name"
        autocomplete="family-name"
        autocapitalize="words"
        value="<%= values?.lastName ?? '' %>"
      />
      <% if (errorMessages?.validationErrors?.lastName?.length > 0) { %>
      <p class="fieldErrorMessage">
        <%= errorMessages?.validationErrors?.lastName %>
      </p>
      <% } %>
    </div>
    <div class="inputContainer">
      <label for="username">Username</label>
      <input
        class="authPageInput"
        type="text"
        name="username"
        id="username"
        autocomplete="username"
        value="<%= values?.username ?? '' %>"
      />
      <% if (errorMessages?.validationErrors?.username?.length > 0) { %>
      <p class="fieldErrorMessage">
        <%= errorMessages?.validationErrors?.username%>
      </p>
      <% } %>
    </div>
    <div class="inputContainer">
      <label for="password">Password</label>
      <div class="passwordInputField">
        <input
          class="authPageInput"
          type="password"
          name="password"
          id="password"
          autocomplete="new-password"
          value="<%= values?.password ?? '' %>"
        />
        <button type="button" class="passwordVisibilityBtn passwordInvisible">
          <img
            src="/assets/icons/password_not_visible.svg"
            alt="show password"
          />
        </button>
      </div>
      <% if (errorMessages?.validationErrors?.password?.length > 0) { %>
      <p class="fieldErrorMessage">
        <%= errorMessages?.validationErrors?.password %>
      </p>
      <% } %>
    </div>

    <div class="inputContainer">
      <label for="rePassword">Re-enter the password</label>
      <div class="rePasswordInputField">
        <input
          class="authPageInput"
          type="password"
          name="rePassword"
          id="rePassword"
          autocomplete="new-password"
          value="<%= values?.rePassword ?? '' %>"
        />
        <button type="button" class="passwordVisibilityBtn passwordInvisible">
          <img
            src="/assets/icons/password_not_visible.svg"
            alt="show password"
          />
        </button>
      </div>
      <% if (errorMessages?.validationErrors?.rePassword?.length > 0) { %>
      <p class="fieldErrorMessage">
        <%= errorMessages?.validationErrors?.rePassword %>
      </p>
      <% } %>
    </div>
    <button class="submitBtn" type="submit">Submit</button>
  </form>
  <p class="authFromRedirect">
    Already have an account? <a href="/auth/login">Login!</a>
  </p>
</div>
