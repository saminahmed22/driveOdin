<div class="file" title="File" data-postId="<%= post.id %>">
  <div class="fileTitle">
    <img src="/assets/icons/image.svg" alt="" />
    <p class="fileDetail fileTitleText" title="<%= post.file_name %>">
      <%= post.file_name_short %>
    </p>

    <% if (post.isProtected) { %>
    <img
      class="postLockIcon invertImg"
      src="/assets/icons/lock.svg"
      alt="Lock icon"
      title="This image is password protected"
    />
    <% } %>
  </div>

  <p class="fileDetail fileSize" title="size"><%= post.file_size%></p>
  <p class="fileDetail fileShareCode" title="Share code"><%= post.id %></p>
  <p class="fileDetail fileCreationDate" title="Creation date">
    <%= post.readableCreationDate %>
  </p>
  <p class="fileDetail fileExpirationDate" title="Expiration date">
    <%= post.readableExpiryDate %>
  </p>

  <div class="fileAction">
    <div class="fileOptions">
      <button class="fileDeleteBtn fileActBtn" title="Delete file">
        <img src="/assets/icons/delete.svg" alt="Delete icon" />
      </button>

      <button class="fileEditBtn fileActBtn" title="Edit file">
        <img src="/assets/icons/edit.svg" alt="Edit icon" />
      </button>
    </div>

    <button class="fileOptionsBtn" title="Expand file options">
      <img src="/assets/icons/left.svg" alt="" />
    </button>
  </div>
</div>
