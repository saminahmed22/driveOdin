generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String   @id @default(cuid(2)) @db.VarChar(30)
  first_name    String
  last_name     String
  username      String   @unique
  password_hash String
  posts         Post[]
  folders       Folder[]
}

model Post {
  id           String   @id @default(nanoid(6))
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  file_name    String
  file_size    String
  location     String
  uploaded_at  DateTime @default(now())
  expires_at   DateTime
  isProtected  Boolean  @default(false)
  passwordHash String?
  folder       Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)
  folderId     String
}

model Folder {
  id           String   @id @default(nanoid(5))
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  folder_name  String
  isProtected  Boolean  @default(false)
  passwordHash String?
  posts        Post[]
  created_at   DateTime @default(now())
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
}
